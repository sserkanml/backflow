{
	"apiVersion": "v1",
	"kind": "List",
	"items": [
		{
			"apiVersion": "v1",
			"kind": "Service",
			"metadata": {
				"name": "web",
				"namespace": "demo"
			},
			"spec": {
				"selector": {
					"app": "web"
				},
				"ports": [
					{
						"port": 80,
						"targetPort": 8080
					}
				]
			}
		},
		{
			"apiVersion": "v1",
			"kind": "ConfigMap",
			"metadata": {
				"name": "settings",
				"namespace": "demo"
			},
			"data": {
				"mode": "base",
				"retries": "3"
			}
		}
	]
}
