{{- /* Generated by hack/genactorconditions from internal/actorwebhook (make helm-sync). Do not edit. */ -}}
{{- define "backflow.actorConditions" -}}
{{- $users := .users -}}
{{- $clause := "true" -}}
{{- if $users }}{{ $clause = printf "!(request.userInfo.username in [%s])" $users }}{{ end -}}
- name: not-secrets
  expression: "request.resource.resource != 'secrets'"
- name: not-dry-run
  expression: "!has(request.dryRun) || request.dryRun == false"
- name: tracked-or-scale
  expression: "(has(request.subResource) && request.subResource == 'scale') || (!has(request.subResource) && ((has(object.metadata.annotations) && 'argocd.argoproj.io/tracking-id' in object.metadata.annotations) || (has(object.metadata.labels) && 'app.kubernetes.io/instance' in object.metadata.labels)))"
- name: not-system-or-gitops-users
  expression: {{ print "!request.userInfo.username.startsWith('system:serviceaccount:kube-system:') && !request.userInfo.username.startsWith('system:node:') && !(request.userInfo.username in ['system:kube-controller-manager', 'system:kube-scheduler']) && " $clause "" | toJson }}
{{- end }}
